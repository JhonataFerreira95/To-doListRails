<div id="<%= dom_id todo_item %>" class="w-full sm:w-auto my-5 space-y-5">
  <div>
    <strong class="block font-medium mb-1">Número da lista:</strong>
    <%= todo_item.todo_list_id %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Descrição do Item:</strong>
    <%= todo_item.text %>
  </div>
  <div>
    <strong class="block font-medium mb-1">Concluído:</strong>
    <%= todo_item.completed? ? "sim" : "não" %>
  </div>
</div>
