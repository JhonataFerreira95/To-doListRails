<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl"><%= @todo_item.text %></h1>

  <%= render @todo_item %>

  <%= link_to "Editar esse item", edit_todo_list_todo_item_path(@todo_list, @todo_item), class: "w-full sm:w-auto text-center rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>

  <%= link_to "Voltar para os itens", todo_list_todo_items_path(@todo_list), class: "w-full sm:w-auto text-center mt-2 sm:mt-0 sm:ml-2 rounded-md px-3.5 py-2.5 bg-gray-100 hover:bg-gray-50 inline-block font-medium" %>

  <%= button_to "Excluir esse item", todo_list_todo_item_path(@todo_list, @todo_item), method: :delete, form_class: "sm:inline-block mt-2 sm:mt-0 sm:ml-2", class: "w-full rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Tem certeza?" } %>
</div>
